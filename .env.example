# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored.

# PostgreSQL connection string for the Anypay production read replica.
# Format: postgres://user:password@host:5432/dbname
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# Secret used to sign session cookies (HMAC-SHA256). Use a long random string;
# changing it invalidates every existing login.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-string
